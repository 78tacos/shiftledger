# Postgres
DATABASE_URL=postgres://shiftledger:shiftledger@localhost:5432/shiftledger

# API
PORT=3001
HOST=0.0.0.0
JWT_SECRET=shiftledger-demo-jwt-secret-not-for-prod
MIGRATIONS_DIR=./db/migrations

# Web (Vite). Leave as /api so the dev proxy and nginx share the same origin path.
VITE_API_URL=/api

# Optional. The API also finds db/migrations from the repo layout.
# Docker Compose sets this to /app/db/migrations.
